{
	"name": "humanmade/schema-org-blocks",
	"description": "Extend all blocks with schema.org type mapping and structured data output",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Human Made",
			"email": "hello@humanmade.com"
		}
	],
	"require": {
		"php": ">=8.0",
		"humanmade/schema-org-validator": "^0.1"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"format": "phpcbf"
	},
	"autoload": {
		"files": [
			"inc/namespace.php",
			"inc/schema-types.php",
			"inc/block-extensions.php",
			"inc/schema-output.php"
		]
	}
}
