{
  "id": "schema-org-blocks/required",
  "title": "Schema.org Blocks required properties",
  "source": "https://github.com/humanmade/hm-schema-block",
  "checked": "2026-10-06",
  "status": "active",
  "statusNote": "",
  "types": [
    "Article",
    "FAQPage",
    "Question",
    "Answer",
    "HowTo",
    "HowToStep",
    "WebSite",
    "ItemList",
    "Organization",
    "LocalBusiness",
    "Person",
    "Product",
    "Event",
    "ImageObject",
    "Offer",
    "Review",
    "Rating",
    "AggregateRating"
  ],
  "required": [
    {"path": "headline", "types": ["Article"]},
    {"path": "author", "types": ["Article"]},
    {"path": "publisher", "types": ["Article"]},
    {"path": "datePublished", "types": ["Article"]},
    {"path": "mainEntity", "types": ["FAQPage"]},
    {"path": "name", "types": ["Question"]},
    {"path": "acceptedAnswer", "types": ["Question"]},
    {"path": "text", "types": ["Answer"]},
    {"path": "name", "types": ["HowTo"]},
    {"path": "step", "types": ["HowTo"]},
    {"path": "text", "types": ["HowToStep"]},
    {"path": "name", "types": ["WebSite"]},
    {"path": "url", "types": ["WebSite"]},
    {"path": "itemListElement", "types": ["ItemList"]},
    {"path": "name", "types": ["Organization", "Person"]},
    {"path": "address", "types": ["LocalBusiness"]},
    {"path": "name", "types": ["Product"]},
    {"anyOf": ["offers", "review", "aggregateRating"], "types": ["Product"]},
    {"path": "name", "types": ["Event"]},
    {"path": "startDate", "types": ["Event"]},
    {"path": "location", "types": ["Event"]},
    {"anyOf": ["contentUrl", "url"], "types": ["ImageObject"]},
    {"path": "price", "types": ["Offer"]},
    {"path": "priceCurrency", "types": ["Offer"]},
    {"path": "author", "types": ["Review"]},
    {"path": "reviewRating", "types": ["Review"]},
    {"path": "ratingValue", "types": ["Rating"]},
    {"anyOf": ["ratingCount", "reviewCount"], "types": ["AggregateRating"]}
  ],
  "notes": [
    "The properties the plugin needs for each type. Schema.org has no required properties. These follow Google's rich result requirements, plus author and publisher for articles."
  ]
}
